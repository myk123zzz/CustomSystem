# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# PostgreSQL；使用文档中的 Docker 示例时可直接使用此地址
DATABASE_URL=postgresql+asyncpg://css:change-this-password@127.0.0.1:5432/cssdb

# 管理后台接口令牌；换机后必须改成随机长字符串
ADMIN_TOKEN=change-this-admin-token

# 可选。压缩包保留项目内模型时无需设置
# BGE_MODEL_PATH=D:\path\to\CustomSystem\models\bge-base-zh-v1.5
